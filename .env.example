# Skills de Instagram (.claude/skills). Tudo opcional: sem chaves, as skills só redigem os textos.
# Copie para .env (nunca commite o .env).
PUBLORA_API_KEY=            # publicar/agendar posts (https://app.publora.com)
INSTAGRAM_PLATFORM_ID=      # ex: instagram-123456 (painel Publora > Channels)
APIFY_TOKEN=                # leitura de nicho/perfis (https://console.apify.com/account/integrations)
PIXFARO_TOKEN=              # geração de imagens (opcional)
