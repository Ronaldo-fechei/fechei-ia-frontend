# ============================================================
# Gatilho — variáveis de ambiente
# Copie para server/.env (ou configure no seu provedor de hospedagem).
# ============================================================

# --- Aplicação ---------------------------------------------------
NODE_ENV=development
PORT=3333
# URL pública do app (OAuth, webhooks, links rastreados e e-mails). Em produção: https://...
APP_URL=http://localhost:5173
# Segredo para assinaturas internas (mínimo 32 caracteres). Gere com: openssl rand -base64 48
APP_SECRET=
# Chave AES-256 para criptografar os tokens do Instagram (32 bytes em base64). Gere com: openssl rand -base64 32
ENCRYPTION_KEY=
# Atrás de proxy/CDN (Render, Railway, Nginx): true
TRUST_PROXY=true
# Executar o worker da fila no mesmo processo da API (true) ou em processo separado (false + npm run start:worker)
RUN_WORKER=true
WORKER_CONCURRENCY=5
# E-mails com papel de administrador (painel /app/admin), separados por vírgula
ADMIN_EMAILS=
# E-mail exibido para suporte e mudança de plano
SUPPORT_EMAIL=
LOG_LEVEL=info

# --- Banco de dados (PostgreSQL 14+) -------------------------------
DATABASE_URL=postgres://gatilho:gatilho@localhost:5432/gatilho
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Meta / Instagram (API do Instagram com login do Instagram) ----
# Painel da Meta → seu app → Instagram → Configuração da API com login do Instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Token que você inventa e cadastra no painel ao configurar o webhook
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments
META_WEBHOOK_FIELDS=messages,messaging_postbacks,messaging_referral,messaging_seen,comments
# Só ative se o recurso Human Agent foi aprovado para o seu app (respostas manuais até 7 dias)
META_HUMAN_AGENT_ENABLED=false

# --- E-mail (SMTP) — recuperação de senha ---------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gatilho <nao-responda@seudominio.com.br>"

# --- IA (opcional) -------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
